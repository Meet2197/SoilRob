import can
import json
import paho.mqtt.client as mqtt
from datetime import datetime

class AckerscannerCANIntegration:
    def __init__(self, channel='can0', bitrate=250000):
        self.bus = can.interface.Bus(channel=channel, bustype='socketcan', bitrate=bitrate)
        self.mqtt_client = mqtt.Client()
        
        # CAN Message IDs (from docs)
        self.CAN_CONTROL = 0x123
        self.CAN_STATUS = 0x124
        self.CAN_ROUGHNESS = 0x125
    
    def connect_mqtt(self, broker='localhost'):
        self.mqtt_client.connect(broker, 1883, 60)
        self.mqtt_client.on_message = self.on_mqtt_message
        self.mqtt_client.subscribe("ackerscanner/commands/#")
        self.mqtt_client.loop_start()
    
    def send_control_command(self, mode, opening_angle):
        """
        Send control message to LiDAR
        Mode: 0x01=Idle, 0x02=Measuring, 0x04=End
        Opening angle: 0-255 degrees
        """
        msg = can.Message(
            arbitration_id=self.CAN_CONTROL,
            data=[mode, opening_angle, 0, 0, 0, 0, 0, 0],
            is_extended_id=False,
            dlc=2
        )
        self.bus.send(msg)
        return True
    
    def start_measurement(self):
        """Start measuring mode"""
        self.send_control_command(mode=0x02, opening_angle=120)
    
    def stop_measurement(self):
        """Stop measuring and go to idle"""
        self.send_control_command(mode=0x01, opening_angle=0)
    
    def read_can_messages(self):
        """Continuously read CAN messages and publish to MQTT"""
        try:
            for msg in self.bus:
                if msg.arbitration_id == self.CAN_STATUS:
                    self.process_status(msg)
                elif msg.arbitration_id == self.CAN_ROUGHNESS:
                    self.process_roughness(msg)
        except KeyboardInterrupt:
            pass
    
    def process_status(self, msg):
        """Process status message (0x124)"""
        mode = msg.data[0]
        opening_angle = msg.data[1]
        error_code = (msg.data[3] << 8) | msg.data[2]
        warning_code = (msg.data[5] << 8) | msg.data[4]
        
        status_data = {
            'timestamp': datetime.now().isoformat(),
            'mode': self._decode_mode(mode),
            'opening_angle': opening_angle,
            'error_code': error_code,
            'warning_code': warning_code,
            'errors': self._decode_errors(error_code),
            'warnings': self._decode_warnings(warning_code)
        }
        
        # Publish to MQTT
        self.mqtt_client.publish(
            "ackerscanner/status",
            json.dumps(status_data)
        )
    
    def process_roughness(self, msg):
        """Process roughness data (0x125)"""
        roughness1 = struct.unpack('>H', msg.data[0:2])[0] * 0.01
        roughness2 = struct.unpack('>H', msg.data[2:4])[0] * 0.01
        roughness3 = struct.unpack('>H', msg.data[4:6])[0] * 0.01
        
        roughness_data = {
            'timestamp': datetime.now().isoformat(),
            'roughness_1': roughness1,
            'roughness_2': roughness2,
            'roughness_3': roughness3,
            'average': (roughness1 + roughness2 + roughness3) / 3
        }
        
        # Publish to MQTT
        self.mqtt_client.publish(
            "ackerscanner/roughness",
            json.dumps(roughness_data)
        )
    
    def _decode_mode(self, mode_byte):
        modes = {0x00: 'Booting', 0x01: 'Idle', 0x02: 'Measuring', 0x03: 'Error', 0x04: 'Ending'}
        return modes.get(mode_byte, 'Unknown')
    
    def _decode_errors(self, error_code):
        errors = []
        if error_code & 0x01: errors.append('No connection')
        if error_code & 0x02: errors.append('Connection lost')
        if error_code & 0x04: errors.append('Internal error')
        if error_code & 0x08: errors.append('Device error')
        if error_code & 0x10: errors.append('Lens contamination')
        if error_code & 0x20: errors.append('Low temperature')
        if error_code & 0x40: errors.append('High temperature')
        if error_code & 0x80: errors.append('Device overload')
        return errors
    
    def _decode_warnings(self, warning_code):
        warnings = []
        if warning_code & 0x01: warnings.append('Device warning')
        if warning_code & 0x02: warnings.append('Lens contamination')
        if warning_code & 0x04: warnings.append('Low temperature')
        if warning_code & 0x08: warnings.append('High temperature')
        if warning_code & 0x10: warnings.append('Device overload')
        return warnings
    
    def on_mqtt_message(self, client, userdata, msg):
        """Handle MQTT commands"""
        payload = msg.payload.decode()
        
        if msg.topic == "ackerscanner/commands/start":
            self.start_measurement()
        elif msg.topic == "ackerscanner/commands/stop":
            self.stop_measurement()
        elif msg.topic == "ackerscanner/commands/setangle":
            angle = int(payload)
            self.send_control_command(mode=0x02, opening_angle=angle)

# Usage
lidar = AckerscannerCANIntegration()
lidar.connect_mqtt('localhost')
lidar.read_can_messages()